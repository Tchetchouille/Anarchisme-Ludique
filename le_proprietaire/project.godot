;   param=value ; assign values to parameters

config_version=5

[application]

config/name="le_propietaire"
run/main_scene="uid://1cqhvtrmyyb0"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://OUR_scenes/": "pink",
"res://data/": "blue",
"res://fonts/": "gray",
"res://hang_scenes/": "red",
"res://sounds/": "orange",
"res://sprites/": "purple",
"res://text_scenes/": "teal"
}

[physics]

